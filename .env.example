# CloudBase 环境
TCB_ENV_ID=
CLOUDBASE_PORT=9000

# 服务端监听配置（本地开发）
HOST=0.0.0.0
PORT=3000
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=<YOUR_API_KEY>
OPENAI_MODEL=deepseek-flash

# 客户端开发配置
CLIENT_PORT=8080
# 开发模式（pnpm dev）的后端地址已由根目录 .env.development 指定为本地后端，
# 无需在此配置；如需临时改指向远程，可在 .env.development.local 中覆盖。

# CloudBase 后端（orpc-api）公网源：web 云函数的 /rpc 反向代理目标
API_ORIGIN=
# 仅用于构建产物（vite build / --mode cloudbase）注入后端地址，
# 开发模式下会被 .env.development 覆盖。
VITE_API_ORIGIN=${API_ORIGIN}
