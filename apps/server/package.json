{
  "name": "@repo/server",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "build": "pnpm run build:local && pnpm run build:cloudbase",
    "build:local": "vite build --config vite.config.ts --mode development",
    "dev": "tsx watch src/dev.ts",
    "build:cloudbase": "vite build --config vite.config.ts --mode cloudbase",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@orpc/server": "catalog:",
    "@repo/api": "workspace:*",
    "drizzle-orm": "catalog:",
    "openai": "catalog:",
    "pg": "^8.23.1",
    "uuid": "^14.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
