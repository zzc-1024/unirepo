{
  "name": "monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:local": "turbo run build:local",
    "build:cloudbase": "turbo run build:cloudbase",
    "dev": "turbo run dev",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt .",
    "check-types": "turbo run check-types",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:ui": "pnpm --filter @repo/e2e test:e2e:ui",
    "cloudbase:deploy": "pnpm --filter @repo/server build:cloudbase && tcb fn deploy orpc-api --force",
    "cloudbase:deploy:web": "pnpm --filter @repo/client build:cloudbase && tcb fn deploy web --force",
    "cloudbase:deploy:all": "pnpm cloudbase:deploy && pnpm cloudbase:deploy:web"
  },
  "devDependencies": {
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.82.0",
    "eslint-plugin-vue": "^10.11.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.82.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0"
}
